[package]
name = "{{project-name}}"
version = "0.1.0"
edition = "2024"

[dependencies]
ruststream = { version = "0.7.0-rc.6", features = ["macros", "json", "asyncapi", "logging"] }
ruststream-lapin = { version = "0.7", features = ["asyncapi"] }
schemars = "1"
serde = { version = "1", features = ["derive"] }
